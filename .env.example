# Supabase Configuration
# Remplacez ces valeurs par vos vraies clés Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Alternative : utilisez VITE_SUPABASE_ANON_KEY (supporté aussi)
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Pour tester sans Supabase, laissez ce fichier vide
# L'application utilisera des valeurs de démo par défaut


{
  "name": "cakenews-audit-scripts",
  "version": "1.0.0",
  "description": "Scripts d'audit pour détecter les incohérences de contrats de données TypeScript",
  "main": "combined-audit.ts",
  "scripts": {
    "audit:unused-exports": "node audit-unused-exports.js",
    "audit:contract-mismatches": "ts-node detect-contract-mismatches.ts",
    "audit:combined": "ts-unused-exports ../tsconfig.json",
    "audit:all": "npm run audit:combined",
    "test": "echo \"Tests non implémentés\" && exit 0"
  },
  "keywords": [
    "typescript",
    "audit",
    "unused-exports",
    "contract-mismatches",
    "code-quality"
  ],
  "author": "CakeNews Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "ts-unused-exports": "^10.1.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2"
  }
}